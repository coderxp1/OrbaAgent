# ==============================================================================
# OrbaAgent Local Development Environment Template
# Usage: Copy to .env or .env.local for local Docker Compose overrides
# ==============================================================================

# API Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
COMMIT_SHA=dev-local

# PostgreSQL 17 Configuration
POSTGRES_USER=orbaagent
POSTGRES_PASSWORD=orbaagent_dev_pw
POSTGRES_DB=orbaagent
DATABASE_URL=postgresql://orbaagent:orbaagent_dev_pw@127.0.0.1:5432/orbaagent

# Redis 7 Configuration
REDIS_URL=redis://127.0.0.1:6379

# MinIO S3 Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_CONSOLE=http://127.0.0.1:9001

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
