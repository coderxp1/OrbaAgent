# OrbaAgent GPU worker — root-owned runtime environment
# Install to: /etc/orbaagent/gpu-worker/worker.env   (root:root 0600)
#
# This file is passed to docker compose with --env-file by the root-owned
# wrapper. It is NOT a .env in the compose directory, so a compromised or
# careless edit to the deployment directory cannot change these values.
#
# NOTHING SECRET GOES HERE. The worker tokens are supplied as Docker secrets
# (see compose.yaml), never as environment values.

# The only implemented generation backend. Unset or any other value leaves
# generation UNAVAILABLE: /health reports false and the generate endpoints
# return 503 MEDIA_GENERATION_UNAVAILABLE. Setting this does NOT by itself make
# the capability available — the model must actually load.
MEDIA_GENERATION_BACKEND=diffusers

MEDIA_GENERATION_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
MEDIA_GENERATION_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B

# One generation at a time until VRAM behaviour is measured on real hardware.
MEDIA_MAX_CONCURRENT_GENERATIONS=1

# Where the worker delivers generated artifacts. This is the WireGuard address
# of the production host (see the network design), never a public address.
MEDIA_INGEST_URL=http://10.77.0.1/api/internal/media/ingest

# Workspace the worker targets. Must match the production deployment's
# ORBA_TENANT_ID, or ingest is rejected with 403.
ORBA_TENANT_ID=

# NOTE: the GPU UUID pins live in the root-owned compose.yaml, not here, so that
# an edit to this file can never widen GPU access.
