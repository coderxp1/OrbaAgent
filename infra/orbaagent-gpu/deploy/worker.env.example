# OrbaAgent GPU worker — root-owned runtime environment
# Install to: /etc/orbaagent/gpu-worker/worker.env   (root:root 0600)
#
# This file is passed to docker compose with --env-file by the root-owned
# wrapper. It is NOT a .env in the compose directory, so a compromised or
# careless edit to the deployment directory cannot change these values.
#
# NOTHING SECRET GOES HERE. The worker tokens are supplied as Docker secrets
# (see compose.yaml), never as environment values.

# The only implemented generation backend. Unset or any other value leaves
# generation UNAVAILABLE: /health reports false and the generate endpoints
# return 503 MEDIA_GENERATION_UNAVAILABLE. Setting this does NOT by itself make
# the capability available — the model must actually load.
MEDIA_GENERATION_BACKEND=diffusers

MEDIA_GENERATION_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
MEDIA_GENERATION_VIDEO_MODEL=Lightricks/LTX-Video

# One generation at a time until VRAM behaviour is measured on real hardware.
MEDIA_MAX_CONCURRENT_GENERATIONS=1

# Where the worker delivers generated artifacts. This is the WireGuard address
# of the production host (see the network design), never a public address.
MEDIA_INGEST_URL=http://10.77.0.1/api/internal/media/ingest

# Workspace the worker targets. Must match the production deployment's
# ORBA_TENANT_ID, or ingest is rejected with 403.
ORBA_TENANT_ID=

# --- GPU allocation policy ----------------------------------------------------
# The compose file pins the worker with ${ORBA_WORKER_GPU_UUID:?} in all three
# places (device reservation, NVIDIA_VISIBLE_DEVICES, MEDIA_WORKER_GPU_UUID).
# Rendering FAILS CLOSED while this is empty, so an unconfigured host cannot
# start a worker that sees every GPU. This file is root:root 0600 exactly like
# compose.yaml, so the delegated account can change neither the mechanism nor
# the value. The validator rejects anything that is not a single GPU-xxxxxxxx-... UUID.
#
# Fill in ONLY from the live host, never from a document:
#   nvidia-smi --query-gpu=index,uuid,name --format=csv
# and confirm with `sudo orbaagent-gpu validate`, which checks the rendered
# compose config AND the live nvidia-smi inventory against these three values.
#
# Allocation decision (Paul Hartmann, 2026-10-24): OrbaAgent worker = host GPU
# index 0; host GPU index 1 reserved for separate MOVA testing (Ollama also runs
# there and is untouched). Live mapping verified read-only by Agent 1 on
# migrol-ag-gpu-worker01 at 2026-10-24T16:35:14Z (GitHub issue #11):
#   0, GPU-4634107e-3bae-d5d5-ff97-2355d0b92ce4, 00000000:01:00.0
#   1, GPU-82e03c6c-8c27-c076-eb42-7e37e9a5a878, 00000000:02:00.0
# `orbaagent-gpu validate` re-checks this against nvidia-smi on EVERY start, so a
# re-enumerated or replaced GPU refuses to start instead of silently moving.
ORBA_WORKER_GPU_UUID=GPU-4634107e-3bae-d5d5-ff97-2355d0b92ce4
# Host index ORBA_WORKER_GPU_UUID is expected to have. Only ever CHECKED against
# nvidia-smi (never used to pick a device); leave empty to skip the index check.
ORBA_WORKER_GPU_INDEX=0
# Comma-separated UUIDs the worker must never see: the MOVA/Ollama GPU.
# The validator fails if any of them appears anywhere in the worker service.
ORBA_WORKER_FORBIDDEN_GPU_UUIDS=GPU-82e03c6c-8c27-c076-eb42-7e37e9a5a878
