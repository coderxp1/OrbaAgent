# Install as /etc/orbaagent/gpu-worker/worker-only/allocation.env, root:root 0600.
# Empty values intentionally fail closed. Do not fill from historical documents.
# GPU 0 is Orba's proposed allocation; GPU 1 is forbidden to this worker for MOVA testing.
# This does NOT establish ownership or authorize stopping/moving any other workload.
# Exact plain KEY=VALUE syntax, no quoting, expansion, duplicates or inline comments.
ORBA_WORKER_GPU_UUID=
ORBA_MOVA_GPU_UUID=
# Pre-existing local image by repository@sha256:<64 lowercase hex>, NOT a tag.
# Building, pulling and approving the image are separate activities, not done by this wrapper.
ORBA_WORKER_IMAGE=
# Actual existing private bridge network name, confirmed by operator; no default/creation.
ORBA_MEDIA_NETWORK=
# Recorded owner approval reference; presence is a gate, not proof of approval authenticity.
# Must cover all GPU 0 occupants, concurrency/VRAM budget and the exact mapping above.
ORBA_GPU_OWNERSHIP_APPROVAL=
