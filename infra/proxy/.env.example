# ==============================================================================
# OrbaAgent Traefik Proxy Environment Variables Template
# Copy to .env on the deployment server. Never commit .env to version control!
# ==============================================================================

# Let's Encrypt Account Email for Renewal Notifications
ACME_EMAIL=ph@klaw.at

# IONOS Developer API Credentials for DNS-01 Challenge
# Obtain from https://developer.hosting.ionos.com
IONOS_API_KEY=your_ionos_public_prefix.your_ionos_secret_key

# Certificate Resolver to Use: 'le-staging' or 'le-prod'
# Default to le-staging during initial testing to avoid Let's Encrypt rate limits!
CERT_RESOLVER=le-staging

# Public Domain Base
DOMAIN=orbaagent.dev
