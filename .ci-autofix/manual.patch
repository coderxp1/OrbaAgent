diff --git a/services/orchestrator/src/mediaVerticalVideoRouting.test.ts b/services/orchestrator/src/mediaVerticalVideoRouting.test.ts
new file mode 100644
index 0000000..e703f0b
--- /dev/null
+++ b/services/orchestrator/src/mediaVerticalVideoRouting.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { extractVideoOrientation, routeUserIntent } from "./intentRouter.js";
+
+// Routing half of the vertical-video regression. The media-tool half lives in
+// services/agent-runtime/src/tools/mediaVerticalVideoRegression.test.ts; it was
+// split out because agent-runtime must not import orchestrator source (the
+// orchestrator depends on agent-runtime, so the reverse import broke tsc -b).
+describe("Exact Prompt Regression (routing): 'Generate a vertical video with 2 females holding a pepsi bottle saying it's delicious.'", () => {
+  const EXACT_PROMPT =
+    "Generate a vertical video with 2 females holding a pepsi bottle saying it's delicious.";
+
+  describe("1. Prompt Routing & Intent Extraction", () => {
+    it("extracts vertical orientation from the exact prompt", () => {
+      const orientation = extractVideoOrientation(EXACT_PROMPT);
+      expect(orientation).toBe("vertical");
+    });
+
+    it("routes to media_video with 9:16 vertical parameters (720x1280) and preserves content", () => {
+      const result = routeUserIntent([{ role: "user", content: EXACT_PROMPT }]);
+      expect(result).not.toBeNull();
+      expect(result.intent).toBe("media_video");
+      expect(result.extractedParameters?.orientation).toBe("vertical");
+      expect(result.extractedParameters?.width).toBe(720);
+      expect(result.extractedParameters?.height).toBe(1280);
+      expect(result.systemGuidance).toContain("CONTENT & PROMPT PRESERVATION POLICY");
+      expect(result.systemGuidance).toContain(
+        "2 females holding a pepsi bottle saying it's delicious",
+      );
+    });
+  });
+});
